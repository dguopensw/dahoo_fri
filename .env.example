# Copy this file to .env and fill in real values locally.
# Do not commit .env.

# Required for GPT vision/image-edit steps.
OPENAI_API_KEY=

# Optional: comma-separated fallback list for image edit models.
GPT_IMAGE_MODELS=gpt-image-1

# Optional: override SAM checkpoint path.
# If omitted, app.py looks for:
# ${SEGMENTATION_PROJECT_DIR}/checkpoints/sam_vit_b_01ec64.pth
SAM_CHECKPOINT=

# Optional: project folder that provides `segmentation.create_segmenter`.
# If omitted, the code expects ../nanobanana_ratio_project.
SEGMENTATION_PROJECT_DIR=

# Optional: Python executable for the LaMa worker environment.
# If omitted, the code tries /opt/miniconda3/envs/lama_env/bin/python.
LAMA_PYTHON=
